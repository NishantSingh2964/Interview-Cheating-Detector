{
  "name": "interview-proctor-server",
  "version": "1.0.0",
  "description": "Express + Socket.IO backend for Interview Proctor",
  "main": "src/index.js",
  "scripts": {
    "start": "node src/index.js",
    "dev": "nodemon src/index.js",
    "build": "npm run setup-voice-model",
    "transcription": "python -m uvicorn app:app --app-dir transcription --host 127.0.0.1 --port 8001",
    "setup-voice-model": "node scripts/setup-voice-model.js",
    "calibrate-voice": "node scripts/calibrate-voice.js",
    "test": "node --test"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "mongoose": "^8.9.5",
    "sherpa-onnx-node": "^2.0.1",
    "socket.io": "^4.8.1"
  },
  "devDependencies": {
    "nodemon": "^3.1.9"
  }
}
